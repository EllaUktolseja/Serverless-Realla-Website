{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=optional && npm install --no-save --platform=linux --arch=x64 lightningcss@1.33.0",
  "buildCommand": "npm run build --workspace=web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
